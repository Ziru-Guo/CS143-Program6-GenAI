import java.util.HashMap;
import java.util.Scanner;

// 1. Contact class to store individual contact details
class Contact {
    private String name;
    private String phoneNumber;

    public Contact(String name, String phoneNumber) {
        this.name = name;
        this.phoneNumber = phoneNumber;
    }

    public String getName() {
        return name;
    }

    public String getPhoneNumber() {
        return phoneNumber;
    }

    public void setPhoneNumber(String phoneNumber) {
        this.phoneNumber = phoneNumber;
    }

    @Override
    public String toString() {
        return "Name: " + name + " | Phone: " + phoneNumber;
    }
}

// 2. Main class to run the console menu
public class ContactBook {

    // Helper method to keep prompting until the user enters non-empty text
    private static String getNonEmptyInput(Scanner scanner, String prompt, String errorMessage) {
        while (true) {
            System.out.print(prompt);
            String input = scanner.nextLine().trim();
            if (!input.isEmpty()) {
                return input;
            }
            System.out.println(errorMessage);
        }
    }

    public static void main(String[] args) {
        HashMap<String, Contact> contacts = new HashMap<>();
        Scanner scanner = new Scanner(System.in);
        boolean running = true;

        while (running) {
            System.out.println("\n--- Contact Book Menu ---");
            System.out.println("1. Add a new contact");
            System.out.println("2. Search for a contact");
            System.out.println("3. Delete a contact");
            System.out.println("4. Display all contacts");
            System.out.println("5. Exit");
            System.out.print("Choose an option (1-5): ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    String name = getNonEmptyInput(
                        scanner,
                        "Enter name: ",
                        "Error: Name cannot be empty. Please try again."
                    );
                    String key = name.toLowerCase();

                    if (contacts.containsKey(key)) {
                        Contact existing = contacts.get(key);
                        System.out.println("Contact already exists -> " + existing);
                        System.out.print("Do you want to update the phone number? (y/n): ");
                        String confirm = scanner.nextLine().trim().toLowerCase();

                        if (confirm.equals("y") || confirm.equals("yes")) {
                            String newPhone = getNonEmptyInput(
                                scanner,
                                "Enter new phone number: ",
                                "Error: Phone number cannot be empty. Please try again."
                            );
                            existing.setPhoneNumber(newPhone);
                            System.out.println("Contact updated!");
                        } else {
                            System.out.println("Update cancelled.");
                        }
                    } else {
                        String phone = getNonEmptyInput(
                            scanner,
                            "Enter phone number: ",
                            "Error: Phone number cannot be empty. Please try again."
                        );
                        contacts.put(key, new Contact(name, phone));
                        System.out.println("Contact saved!");
                    }
                    break;

                case "2":
                    System.out.print("Enter name to search: ");
                    String searchName = scanner.nextLine().trim().toLowerCase();

                    Contact found = contacts.get(searchName);
                    if (found != null) {
                        System.out.println("Found -> " + found);
                    } else {
                        System.out.println("Contact not found.");
                    }
                    break;

                case "3":
                    System.out.print("Enter name to delete: ");
                    String deleteName = scanner.nextLine().trim().toLowerCase();

                    if (contacts.remove(deleteName) != null) {
                        System.out.println("Contact deleted.");
                    } else {
                        System.out.println("Contact not found.");
                    }
                    break;

                case "4":
                    if (contacts.isEmpty()) {
                        System.out.println("No contacts saved yet.");
                    } else {
                        System.out.println("\n--- Saved Contacts ---");
                        for (Contact contact : contacts.values()) {
                            System.out.println(contact);
                        }
                    }
                    break;

                case "5":
                    running = false;
                    System.out.println("Goodbye!");
                    break;

                default:
                    System.out.println("Invalid option. Please enter a number from 1 to 5.");
            }
        }

        scanner.close();
    }
}
